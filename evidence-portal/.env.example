# Sao chép file này thành .env.local rồi điền đúng cấu hình lấy từ:
# Firebase Console → Project settings → General → Your apps → (chọn app Web) → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email quản trị đầu tiên — tự động có toàn quyền duyệt ngay khi đăng nhập lần đầu, không cần
# ai duyệt trước. Phải khớp với danh sách trong firestore.rules (biến isBootstrapAdmin()).
VITE_BOOTSTRAP_ADMIN_EMAIL=hiennguyen307@gmail.com

# Cloudinary — dùng để lưu file minh chứng (thay cho Firebase Storage, không cần gói trả phí).
# Lấy Cloud name ở Dashboard, tạo Upload preset ở Settings → Upload → Upload presets (Signing Mode = Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
