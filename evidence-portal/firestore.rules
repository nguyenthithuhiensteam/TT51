rules_version = '2';

// Cổng minh chứng kiểm định — mọi quyền đều bắt buộc đăng nhập Google. Vai trò 'pending' (mặc
// định khi đăng nhập lần đầu) không được đọc/ghi gì ngoài hồ sơ của chính mình, cho đến khi
// quản trị viên duyệt và gán vai trò staff/approver/admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Email quản trị khởi tạo — TRÙNG với VITE_BOOTSTRAP_ADMIN_EMAIL. Chỉ dùng để tự cấp quyền
    // admin ở lần tạo hồ sơ user ĐẦU TIÊN của chính email này; không cấp quyền gì khác.
    function isBootstrapAdminEmail() {
      return request.auth.token.email == 'hiennguyen307@gmail.com';
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isApproved() {
      return isSignedIn() && myRole() in ['staff', 'approver', 'admin'];
    }

    function isApprover() {
      return isSignedIn() && myRole() in ['approver', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == (isBootstrapAdminEmail() ? 'admin' : 'pending');
      // Chỉ admin được đổi vai trò của người khác sau khi đã tạo.
      allow update: if isAdmin();
    }

    match /standards/{id} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /criteria/{id} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /evidence/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'pending_approval';
      // Chỉ người có quyền duyệt được đổi trạng thái/ghi chú; không ai được sửa nội dung tệp
      // đã tải lên (fileUrl/storagePath/uploadedBy bất biến sau khi tạo).
      allow update: if isApprover()
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && request.resource.data.fileUrl == resource.data.fileUrl
        && request.resource.data.storagePath == resource.data.storagePath;
      allow delete: if false;
    }

    // ===================== MN360 (hệ điều hành trường mầm non số) =====================
    // Toàn bộ collection tiền tố "mn360_" thuộc ứng dụng MN360 (khác Cổng minh chứng ở trên,
    // dùng chung project Firestore nhưng namespace riêng để không xung đột). Phân quyền dựa
    // trên permissionCodes lưu trực tiếp trên hồ sơ user (không cần custom claims/Cloud
    // Functions — vẫn hoạt động trên gói Firebase miễn phí).

    function mn360IsSignedIn() {
      return request.auth != null;
    }

    function mn360Perms() {
      return get(/databases/$(database)/documents/mn360_users/$(request.auth.uid)).data.permissionCodes;
    }

    function mn360HasPerm(code) {
      return mn360IsSignedIn() && code in mn360Perms();
    }

    function mn360HasAnyPerm(codes) {
      return mn360IsSignedIn() && mn360Perms().hasAny(codes);
    }

    match /mn360_users/{uid} {
      // Tên/hồ sơ cơ bản cần đọc được rộng rãi để hiển thị người phụ trách/người soạn ở các
      // phân hệ khác (chủ trì nhiệm vụ, người duyệt...) — không chứa dữ liệu nhạy cảm.
      allow read: if mn360IsSignedIn();
      // Chỉ tự sửa hồ sơ của chính mình (đổi mật khẩu, ghi nhận đăng nhập). Quản trị viên tạo/
      // sửa tài khoản người khác sẽ làm qua script/quy trình riêng ở các đợt sau.
      allow write: if mn360IsSignedIn() && request.auth.uid == uid;
    }

    match /mn360_schools/{id} {
      allow read: if mn360IsSignedIn();
      // "create" cho phép script khởi tạo (seed-firebase.mjs) chạy lần đầu; chưa có màn hình
      // sửa trường nên không cần "update" — sẽ gạt lại bằng quyền system.edit khi xây xong.
      allow create: if mn360IsSignedIn();
      allow update, delete: if false;
    }

    match /mn360_school_years/{id} {
      allow read: if mn360IsSignedIn();
      allow create: if mn360IsSignedIn();
      allow update, delete: if false;
    }

    match /mn360_tasks/{id} {
      allow read: if mn360HasPerm('task.view');
      allow create: if mn360HasPerm('task.create');
      allow update: if mn360HasAnyPerm(['task.edit', 'task.submit', 'task.approve']);
      allow delete: if false;
    }

    match /mn360_task_status_history/{id} {
      allow read: if mn360HasPerm('task.view');
      allow create: if mn360HasAnyPerm(['task.edit', 'task.submit', 'task.approve']);
      allow update, delete: if false;
    }

    match /mn360_task_comments/{id} {
      allow read: if mn360HasPerm('task.view');
      allow create: if mn360HasPerm('task.view') && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /mn360_task_evidence/{id} {
      allow read: if mn360HasPerm('task.view');
      allow create: if mn360HasPerm('task.view') && request.resource.data.uploaded_by == request.auth.uid;
      allow update, delete: if false;
    }

    match /mn360_notifications/{id} {
      allow read: if mn360IsSignedIn() && resource.data.user_id == request.auth.uid;
      // Ghi hộ thông báo cho người khác (VD: nhắc chủ trì nhiệm vụ quá hạn) — nội dung do hệ
      // thống tự sinh từ dữ liệu nhiệm vụ thật, không phải nội dung tự do người dùng nhập.
      allow create: if mn360HasPerm('task.view');
      allow update: if mn360IsSignedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    match /mn360_counters/{id} {
      allow read, write: if mn360HasPerm('task.create');
    }

    match /mn360_audit_logs/{id} {
      allow create: if mn360IsSignedIn();
      allow read: if mn360HasPerm('system.view');
      allow update, delete: if false;
    }

    // --------------------- Trẻ em ---------------------

    match /mn360_classes/{id} {
      allow read: if mn360HasAnyPerm(['children.view', 'health.view', 'nutrition.view']);
      allow create: if mn360HasPerm('children.create');
      allow update: if mn360HasAnyPerm(['children.edit', 'children.approve']);
      allow delete: if false;
    }

    match /mn360_children/{id} {
      // health.view/nutrition.view cũng cần đọc hồ sơ trẻ cơ bản (khám sức khỏe, dị ứng, khẩu
      // phần theo lớp) dù không có quyền quản lý Trẻ em đầy đủ.
      allow read: if mn360HasAnyPerm(['children.view', 'health.view', 'nutrition.view']);
      allow create: if mn360HasPerm('children.create');
      // update dùng chung cho sửa hồ sơ, cập nhật nhân khẩu học, đổi trạng thái, thêm phụ huynh
      // (đều nhúng trên cùng tài liệu) — mọi thao tác này đều yêu cầu ít nhất children.edit.
      allow update: if mn360HasAnyPerm(['children.edit', 'children.approve']);
      allow delete: if false;
    }

    match /mn360_child_status_history/{id} {
      allow read: if mn360HasPerm('children.view');
      allow create: if mn360HasAnyPerm(['children.edit', 'children.approve']);
      allow update, delete: if false;
    }

    match /mn360_attendance/{id} {
      allow read: if mn360HasAnyPerm(['children.view', 'health.view', 'nutrition.view']);
      allow create, update: if mn360HasAnyPerm(['children.edit', 'children.create']);
      allow delete: if false;
    }

    match /mn360_child_leave_requests/{id} {
      // Tạo đơn (từ phía phụ huynh) thuộc phân hệ Phụ huynh — chưa chuyển đổi ở đợt này. Ở đây
      // chỉ mở quyền đọc/duyệt cho giáo viên/quản lý.
      allow read: if mn360HasPerm('children.view');
      allow update: if mn360HasAnyPerm(['children.edit', 'children.approve']);
      allow create, delete: if false;
    }

    match /mn360_parent_messages/{id} {
      allow read: if mn360HasPerm('children.view');
      allow create: if mn360HasPerm('children.view') && request.resource.data.sender_user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // --------------------- Đội ngũ ---------------------

    match /mn360_staff/{id} {
      allow read: if mn360HasPerm('staff.view');
      allow create: if mn360HasPerm('staff.create');
      allow update: if mn360HasAnyPerm(['staff.edit', 'staff.approve']);
      allow delete: if false;
    }

    match /mn360_staff_assignments/{id} {
      allow read: if mn360HasPerm('staff.view');
      allow create: if mn360HasAnyPerm(['staff.edit', 'staff.create']);
      allow update, delete: if false;
    }

    match /mn360_staff_leaves/{id} {
      allow read: if mn360HasPerm('staff.view');
      allow create: if mn360HasPerm('staff.view') && request.resource.data.created_by == request.auth.uid;
      allow update: if mn360HasAnyPerm(['staff.edit', 'staff.approve']);
      allow delete: if false;
    }

    match /mn360_staff_evaluations/{id} {
      allow read: if mn360HasPerm('staff.view');
      allow create, update: if mn360HasAnyPerm(['staff.edit', 'staff.approve']);
      allow delete: if false;
    }

    // --------------------- Công tác Đảng (CÁCH LY HOÀN TOÀN) ---------------------
    // Chỉ có 4 mã quyền party.* mới mở được các collection này — không có đường nào khác
    // (không permission chung "system.*"/admin nào) chạm được vào dữ liệu Đảng, đúng nguyên
    // tắc cách ly của bản gốc (xem 016_party.sql).

    match /mn360_party_members/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create: if mn360HasPerm('party.create');
      allow update: if mn360HasAnyPerm(['party.edit', 'party.approve']);
      allow delete: if false;
    }

    match /mn360_party_meetings/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create: if mn360HasPerm('party.create');
      allow update: if mn360HasAnyPerm(['party.edit', 'party.approve']);
      allow delete: if false;
    }

    match /mn360_party_meeting_minutes/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create: if mn360HasAnyPerm(['party.edit', 'party.create']);
      allow update, delete: if false;
    }

    match /mn360_party_resolutions/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create: if mn360HasPerm('party.create');
      allow update: if mn360HasAnyPerm(['party.edit', 'party.approve']);
      allow delete: if false;
    }

    match /mn360_resolution_tracking/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create: if mn360HasAnyPerm(['party.edit', 'party.create']);
      allow update, delete: if false;
    }

    match /mn360_party_member_evaluations/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create, update: if mn360HasAnyPerm(['party.edit', 'party.approve']);
      allow delete: if false;
    }

    match /mn360_party_fees/{id} {
      allow read: if mn360HasPerm('party.view');
      allow create, update: if mn360HasAnyPerm(['party.edit', 'party.approve']);
      allow delete: if false;
    }

    // --------------------- Chuyên môn ---------------------

    match /mn360_education_plans/{id} {
      allow read: if mn360HasPerm('curriculum.view');
      allow create: if mn360HasPerm('curriculum.create');
      allow update: if mn360HasAnyPerm(['curriculum.create', 'curriculum.submit', 'curriculum.approve']);
      allow delete: if false;
    }

    // Dùng chung cho lịch sử phê duyệt kế hoạch giáo dục, thực đơn, tiêu chí kiểm định, văn bản
    // (đều là quy trình soạn→duyệt tương tự nhau) — field "plan_id" là id của bản ghi tương ứng.
    match /mn360_plan_approvals/{id} {
      allow read: if mn360HasAnyPerm([
        'curriculum.view', 'nutrition.view', 'accreditation.view', 'document.view',
      ]);
      allow create: if mn360HasAnyPerm([
        'curriculum.submit', 'curriculum.approve',
        'nutrition.edit', 'nutrition.approve',
        'accreditation.create', 'accreditation.edit', 'accreditation.approve',
        'document.submit', 'document.approve', 'document.publish',
      ]);
      allow update, delete: if false;
    }

    match /mn360_observations/{id} {
      allow read: if mn360HasAnyPerm(['curriculum.view', 'children.view']);
      allow create: if mn360HasPerm('curriculum.create');
      allow update, delete: if false;
    }

    match /mn360_child_assessments/{id} {
      allow read: if mn360HasAnyPerm(['curriculum.view', 'children.view']);
      allow create: if mn360HasPerm('curriculum.create');
      allow update, delete: if false;
    }

    // --------------------- Nuôi dưỡng ---------------------

    match /mn360_dishes/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update, delete: if false;
    }

    match /mn360_menus/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update: if mn360HasAnyPerm(['nutrition.edit', 'nutrition.approve']);
      allow delete: if false;
    }

    match /mn360_menu_items/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create, delete: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update: if false;
    }

    match /mn360_suppliers/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update, delete: if false;
    }

    match /mn360_food_deliveries/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update, delete: if false;
    }

    match /mn360_three_step_inspections/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create, update: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow delete: if false;
    }

    match /mn360_foods/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update, delete: if false;
    }

    match /mn360_nutrition_norms/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow write: if false;
    }

    match /mn360_daily_rations/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
      allow update: if mn360HasAnyPerm(['nutrition.edit', 'nutrition.approve']);
      allow delete: if false;
    }

    match /mn360_ration_items/{id} {
      allow read: if mn360HasPerm('nutrition.view');
      allow create, update, delete: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
    }

    // system_settings dùng chung cho vài mảnh cấu hình nhỏ (định mức tiền ăn, checklist chính
    // sách) — đọc rộng cho mọi người đăng nhập, ghi giới hạn theo quyền nutrition.
    match /mn360_system_settings/{id} {
      allow read: if mn360IsSignedIn();
      allow write: if mn360HasAnyPerm(['nutrition.create', 'nutrition.edit']);
    }

    // --------------------- Sức khỏe – An toàn ---------------------
    // health_records đọc thêm cho nutrition.view vì Nuôi dưỡng cần đối chiếu dị ứng khi lập
    // thực đơn (checkAllergyWarnings) — không có đường nào khác chạm được dữ liệu sức khỏe.

    match /mn360_health_records/{id} {
      allow read: if mn360HasAnyPerm(['health.view', 'nutrition.view']);
      allow write: if mn360HasAnyPerm(['health.create', 'health.edit']);
    }

    match /mn360_growth_measurements/{id} {
      allow read: if mn360HasPerm('health.view');
      allow write: if mn360HasAnyPerm(['health.create', 'health.edit']);
    }

    match /mn360_who_growth_standards/{id} {
      allow read: if mn360HasPerm('health.view');
      allow write: if false;
    }

    match /mn360_vaccinations/{id} {
      allow read: if mn360HasPerm('health.view');
      allow create: if mn360HasAnyPerm(['health.create', 'health.edit']);
      allow update, delete: if false;
    }

    match /mn360_physical_exams/{id} {
      allow read: if mn360HasPerm('health.view');
      allow write: if mn360HasAnyPerm(['health.create', 'health.edit']);
    }

    match /mn360_incidents/{id} {
      allow read: if mn360HasPerm('health.view');
      allow create: if mn360HasAnyPerm(['health.create', 'health.edit']);
      allow update, delete: if false;
    }

    match /mn360_safety_inspections/{id} {
      allow read: if mn360HasPerm('health.view');
      allow create: if mn360HasAnyPerm(['health.create', 'health.edit']);
      allow update: if mn360HasAnyPerm(['health.edit', 'health.approve']);
      allow delete: if false;
    }

    // --------------------- Tài chính – Tài sản ---------------------

    match /mn360_fee_items/{id} {
      allow read: if mn360HasPerm('finance.view');
      allow create: if mn360HasAnyPerm(['finance.create', 'finance.edit']);
      allow update, delete: if false;
    }

    match /mn360_revenues/{id} {
      allow read: if mn360HasPerm('finance.view');
      allow create: if mn360HasAnyPerm(['finance.create', 'finance.edit']);
      allow update: if mn360HasAnyPerm(['finance.edit', 'finance.approve']);
      allow delete: if false;
    }

    match /mn360_expenses/{id} {
      allow read: if mn360HasPerm('finance.view');
      allow create: if mn360HasAnyPerm(['finance.create', 'finance.edit']);
      allow update: if mn360HasAnyPerm(['finance.edit', 'finance.approve']);
      allow delete: if false;
    }

    match /mn360_assets/{id} {
      allow read: if mn360HasPerm('finance.view');
      allow create: if mn360HasAnyPerm(['finance.create', 'finance.edit']);
      allow update: if mn360HasAnyPerm(['finance.edit', 'finance.approve']);
      allow delete: if false;
    }

    match /mn360_asset_status_history/{id} {
      allow read: if mn360HasPerm('finance.view');
      allow create: if mn360HasAnyPerm(['finance.edit', 'finance.approve']);
      allow update, delete: if false;
    }

    // --------------------- Kiểm định ---------------------

    match /mn360_accreditation_standards/{id} {
      allow read: if mn360HasPerm('accreditation.view');
      allow create: if mn360HasAnyPerm(['accreditation.create', 'accreditation.edit']);
      allow update, delete: if false;
    }

    match /mn360_accreditation_criteria/{id} {
      allow read: if mn360HasPerm('accreditation.view');
      allow create: if mn360HasAnyPerm(['accreditation.create', 'accreditation.edit']);
      allow update: if mn360HasAnyPerm(['accreditation.edit', 'accreditation.approve']);
      allow delete: if false;
    }

    match /mn360_criteria_assignments/{id} {
      allow read: if mn360HasPerm('accreditation.view');
      allow write: if mn360HasAnyPerm(['accreditation.edit', 'accreditation.approve']);
    }

    match /mn360_evidence_files/{id} {
      allow read: if mn360HasPerm('accreditation.view');
      allow create: if mn360HasAnyPerm(['accreditation.create', 'accreditation.edit']);
      allow update, delete: if false;
    }

    match /mn360_criteria_evidence_links/{id} {
      allow read: if mn360HasPerm('accreditation.view');
      allow write: if mn360HasAnyPerm(['accreditation.create', 'accreditation.edit']);
    }

    // --------------------- Văn phòng số ---------------------

    match /mn360_documents/{id} {
      allow read: if mn360HasPerm('document.view');
      allow create: if mn360HasPerm('document.create');
      allow update: if mn360HasAnyPerm(['document.create', 'document.submit', 'document.approve', 'document.publish']);
      allow delete: if false;
    }

    match /mn360_document_versions/{id} {
      allow read: if mn360HasPerm('document.view');
      allow create: if mn360HasAnyPerm(['document.create', 'document.submit']);
      allow update, delete: if false;
    }

    match /mn360_document_task_links/{id} {
      allow read: if mn360HasAnyPerm(['document.view', 'task.view']);
      allow create: if mn360HasAnyPerm(['document.view', 'task.create']);
      allow update, delete: if false;
    }
  }
}
