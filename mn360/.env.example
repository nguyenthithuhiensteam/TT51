# Cấu hình cho bản build web THẬT (vite.firebase.config.ts / npm run build:firebase) —
# lấy từ Firebase Console → Project settings → General → Your apps → (chọn app Web).
# Dùng chung project Firebase với Cổng minh chứng kiểm định (evidence-portal), nhưng dữ liệu
# tách riêng trong các collection tiền tố "mn360_" nên không xung đột.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
