# Nhà cung cấp AI: gemini | openai | openai_compatible
AI_PROVIDER=gemini

# Mô hình mặc định theo nhà cung cấp
AI_MODEL=gemini-2.0-flash

# Khoá API - KHÔNG commit giá trị thật vào git. Có thể để trống và cấu hình qua
# màn hình "Cài đặt AI" trong ứng dụng (được lưu phía server, không lộ ra trình duyệt).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Chỉ dùng khi AI_PROVIDER=openai_compatible (vd: một endpoint tương thích OpenAI API)
AI_COMPATIBLE_BASE_URL=

# Khoá bí mật dùng để ký token đăng nhập (bắt buộc đổi khi triển khai thật)
AUTH_SECRET=doi-khoa-bi-mat-nay-khi-trien-khai

PORT=8787
